FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ poppler-utils antiword && rm -rf /var/lib/apt/lists/*
WORKDIR /build/dashboard/server
COPY server/package*.json ./
RUN npm ci
COPY server/ ./
COPY test-support/baseline.db /build/dashboard/data/crypto-intelligence.db
COPY test-support/frozen /build/.work/crypto-v2/dashboard-handoff-20260803T010000Z
RUN npm run build && npm run typecheck
ENV SOURCE_PROCESSING_ENABLED=false INTELLIGENCE_AUTO_REFRESH_HOURS=0 HOST=127.0.0.1 PORT=5183 AUTH_MODE=development
CMD ["sh", "-ec", "node dist/index.js > /tmp/test-server.log 2>&1 & pid=$!; trap 'kill $pid 2>/dev/null || true' EXIT; node -e \"(async()=>{for(let i=0;i<100;i++){try{if((await fetch('http://127.0.0.1:5183/api/health')).ok)return}catch{} await new Promise(r=>setTimeout(r,100))}process.exit(1)})()\"; npm test"]
