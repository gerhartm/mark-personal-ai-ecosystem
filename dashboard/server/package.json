{
  "name": "crypto-intelligence-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:db": "node src/build-db.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:production": "node dist/index.js",
    "acceptance": "node src/acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
