# Create a tunnel in the destination owner's account and replace the placeholders.
# Keep the final 404 rule. OpenViking is intentionally absent.
tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_ID.json
metrics: 127.0.0.1:20241
no-autoupdate: true

ingress:
  - hostname: REPLACE_MANAGEMENT_HOSTNAME
    path: ^/terminal/ws.*
    service: http://127.0.0.1:6002
  - hostname: REPLACE_REALTIME_HOSTNAME
    service: http://127.0.0.1:6001
  - hostname: REPLACE_MANAGEMENT_HOSTNAME
    service: http://127.0.0.1:8000
  - hostname: REPLACE_HERMES_HOSTNAME
    service: http://127.0.0.1:9119
  - hostname: REPLACE_CRYPTO_HOSTNAME
    service: http://127.0.0.1:9330
  - hostname: REPLACE_FORKEDBRAIN_HOSTNAME
    service: http://127.0.0.1:9320
  - service: http_status:404
